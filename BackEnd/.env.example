PORT=3000
MONGODB_URI=mongodb://localhost:27017/edunity
# Required: development or production. Any other value (or none) and the server refuses to start.
NODE_ENV=development
# Comma-separated list of exact origins. Required in production; "*" is rejected.
CORS_ORIGIN=http://localhost:5173,http://172.20.10.6:5173
# Number of reverse proxies in front of the app (e.g. 1 behind Nginx/Render). Needed for correct per-client rate limits.
TRUST_PROXY=

# ---- Secrets -----------------------------------------------------------------------------------
# Generate each one separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production: required, at least 32 characters, all different. The server refuses to start otherwise.
# Development: may stay empty; a random value is generated per run (old access tokens die on restart).
JWT_SECRET=
FILE_URL_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Only needed when LiveKit below is not configured
ROOM_TOKEN_SECRET=

JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Business settings
SEAT_HOLD_MINUTES=15
COMMISSION_RATE=0.10
COMMISSION_POLICY_VERSION=DEV_POLICY_V1
COMMISSION_POLICY_APPROVED=false
REQUIRE_APPROVED_COMMISSION_POLICY=false
SCHOLARSHIP_VALID_DAYS=180
APP_TZ_OFFSET_MINUTES=420

# Financial Outbox Recovery Worker (TIN-FIN-PR5)
ENABLE_FINANCIAL_OUTBOX_WORKER=false
FINANCIAL_OUTBOX_INTERVAL_MS=30000
FINANCIAL_OUTBOX_BATCH_SIZE=25

# Embedded classroom (LiveKit). Leave all empty to use the local dev token; set all three or none.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Directory, as seen from the LiveKit Egress container, of the volume the backend mounts as STORAGE_DIR.
# Recordings are written to <this dir>/<storageKey> so the backend can serve them. Empty = Egress default path.
LIVEKIT_EGRESS_OUTPUT_DIR=
# With LiveKit configured, a session cannot start unless its recording starts. Set to false to allow unrecorded classes.
RECORDING_REQUIRED=true
# Recordings are deleted this many days after they become available
RECORDING_RETENTION_DAYS=90
# A recording still PROCESSING this long after the session ended is marked FAILED
RECORDING_PROCESSING_TIMEOUT_HOURS=6
# If the Teacher is in the room but has not pressed "Bắt đầu buổi học", the system starts it this long after the start time
SESSION_AUTO_START_AFTER_MINUTES=10

# Optional comma-separated DNS servers (e.g. 8.8.8.8,1.1.1.1) when the default resolver cannot resolve mongodb+srv
DNS_SERVERS=

# File storage
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://172.20.10.6:3000
FILE_URL_TTL_SECONDS=300

# ---- Payment (payOS VietQR — Unified 2-Channel Engine) -----------------------------------------
# Global switch or per-channel switch. When PAYOS_ENABLED=false, deterministic mock VietQR/Payment Intent
# is allowed ONLY in development/test.
PAYOS_ENABLED=false
PAYOS_TIMEOUT_MS=10000
PAYOS_RETURN_URL=http://localhost:5173/payment/return
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# Channel 1: TUITION (Học sinh đóng học phí — Tài khoản nhận học phí)
PAYOS_TUITION_CLIENT_ID=
PAYOS_TUITION_API_KEY=
PAYOS_TUITION_CHECKSUM_KEY=
PAYOS_TUITION_RETURN_URL=http://localhost:5173/payment/return
PAYOS_TUITION_CANCEL_URL=http://localhost:5173/payment/cancel

# Channel 2: DONATION (Mạnh Thường Quân tài trợ — Tài khoản quỹ học bổng)
PAYOS_DONATION_CLIENT_ID=
PAYOS_DONATION_API_KEY=
PAYOS_DONATION_CHECKSUM_KEY=
PAYOS_DONATION_RETURN_URL=http://localhost:5173/sponsor/contributions/return
PAYOS_DONATION_CANCEL_URL=http://localhost:5173/sponsor/contributions/cancel

# Fallback single-channel keys (backward-compatible)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
